---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url.js';

const posts = await getCollection('articles');
const byId = Object.fromEntries(posts.map((p) => [p.id, p]));

// 編集的クラスタ＝「思想の地図」。各記事は単一クラスタに割り当てる（純血種はいない、というレンズに倣い重複計上しない）。
const clusters = [
  {
    title: '恐怖と学習 — 檻の中の核機構',
    intro: '罰・恐怖・学習が行動をどう作り、どう壊すか。理論の背骨。',
    ids: ['controllability', 'fear-kills-learning', 'one-trial-ethology', 'attribution-ethology', 'habit-ethology', 'precedent-lockin', 'torpor-ethology', 'play-ethology'],
  },
  {
    title: '報酬と動機 — 足すほど効かない逆説',
    intro: '報酬は1本のダイヤルではない。撤回・置換・順応が動機を裏切る。',
    ids: ['reward-trap', 'crowding-out', 'hedonic-treadmill-ethology', 'unfairness-cost', 'price-ethology'],
  },
  {
    title: '5つの群れ — 組織の類型',
    intro: '純血種はいない。5つの動物が、組織のどこに棲むか。',
    ids: ['five-types-ethology', 'wolf-ethology', 'ant-ethology', 'chimp-ethology', 'bonobo-ethology', 'hyena-ethology'],
  },
  {
    title: '群れの知と影 — 集団・同調・協力',
    intro: '個を集めると創発する知恵と、その暗黒面。',
    ids: ['swarm-ethology', 'mobbing-ethology', 'division-of-labor-ethology', 'cooperation-ethology', 'territory-ethology', 'parasitism-ethology', 'connection-ethology', 'status-ethology'],
  },
  {
    title: '組織の時間 — 進化・規模・階層',
    intro: '組織は時間とともに硬直し、規模で相転移する。それに逆らう機構。',
    ids: ['evolution-ethology', 'dunbar-wall', 'hierarchy-design', 'rewilding', 'industry-ethology'],
  },
  {
    title: '檻の外 — 機構はどこまで届くか',
    intro: '動物実験の機構が、歴史と金融のマクロ現象に独立に届く（consilience）。',
    ids: ['uprising', 'bank-run'],
  },
  {
    title: '実務に効く — 応用テーマ',
    intro: '営業・採用・交渉・先延ばし。現場のレンズ。',
    ids: ['sales-ethology', 'recruitment-ethology', 'negotiation-ethology', 'procrastination-ethology', 'foraging-ethology', 'diagnosis-ethology'],
  },
];

const pick = (ids) => ids.map((id) => byId[id]).filter(Boolean);

// 取りこぼし防止：どのクラスタにも属さない記事（後から増えた分など）は「その他」へ。
const assigned = new Set(clusters.flatMap((c) => c.ids));
const orphans = posts
  .filter((p) => !assigned.has(p.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const total = posts.length;
---
<Base title="記事 — 動物から組織を読む" description="二層の組織理論からの、検証可能で非自明な記事。テーマ別の地図。">
  <h1>記事</h1>
  <p class="muted">通俗経営論と分岐する、検証可能な帰結を動物行動学のレンズで。全 {total} 本をテーマ別に。</p>

  {posts.length === 0 ? (
    <p>準備中です。</p>
  ) : (
    <>
      {clusters.map((c) => {
        const items = pick(c.ids);
        return items.length === 0 ? null : (
          <section class="cluster">
            <h2>{c.title}</h2>
            <p class="muted cluster-intro">{c.intro}</p>
            <ul class="post-list">
              {items.map((p) => (
                <li>
                  <a href={url(`articles/${p.id}/`)}>
                    <span class="post-title">{p.data.title}</span>
                    <span class="post-desc">{p.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      {orphans.length > 0 && (
        <section class="cluster">
          <h2>その他</h2>
          <ul class="post-list">
            {orphans.map((p) => (
              <li>
                <a href={url(`articles/${p.id}/`)}>
                  <span class="post-title">{p.data.title}</span>
                  <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toLocaleDateString('ja-JP')}</time>
                  <span class="post-desc">{p.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}
</Base>

<style>
  .cluster { margin-top: 2.75rem; }
  .cluster-intro { margin-top: -0.35rem; }
</style>
