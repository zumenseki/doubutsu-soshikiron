---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url.js';
const types = [
  { name: 'オオカミ', line: '学習と承認・少数精鋭。スピードと創造（スタートアップ／R&D／精鋭営業）。' },
  { name: 'アリ', line: '同調と再現性・中央理念。大規模化と安定供給（チェーン／工場／行政）。' },
  { name: 'チンパン', line: '地位と政治・連合。100人超で自然発生する権力ゲーム（大企業本社／官僚）。' },
  { name: 'ボノボ', line: '共感と低恐怖・親和。安全だが緩い、ぬるま湯のリスク（福祉／教育）。' },
  { name: 'ハイエナ', line: '数字と歩合・未達への恐怖。短期爆発と燃え尽き（歩合営業）。' },
];
---
<Base title="動物から組織を読む — 二層の組織理論">
  <section class="hero">
    <span class="tag">二層の組織理論</span>
    <h1>動物から組織を読む</h1>
    <p class="lede">
      組織を <strong>二層</strong> で読む。ミクロ＝動物実験ベースの<strong>形式的な学習機構</strong>（恐怖・報酬・学習を方程式で）。
      マクロ＝社会行動学ベースの<strong>5類型</strong>（オオカミ／アリ／チンパン／ボノボ／ハイエナ）。
      両層を「多エージェント集計＝文化」で接続する。
    </p>
    <p>
      <a class="cta" href={url('theory/')}>理論を読む</a>
      <a class="cta" href={url('articles/')}>記事一覧</a>
    </p>
  </section>

  <h2>5つの動物相（比喩）</h2>
  <p class="muted">純血種の組織は存在しない。層ごと・局面ごとに<strong>どの動物相へ寄っているか</strong>を見るレンズ。</p>
  <ul class="types">
    {types.map((t) => (
      <li><b>{t.name}</b><span>{t.line}</span></li>
    ))}
  </ul>

  <h2>この理論の身分</h2>
  <p>
    これは「組織データで係数が当たっているモデル」ではない。価値は3点 ——
    諸主張が一つの機構から矛盾なく導かれる<strong>内的整合性</strong>、通俗経営論と分岐する<strong>非自明な予測</strong>、
    「報酬を増やせば効く」式の暗黙仮定を式の上で反証できる<strong>前提の可視化</strong>。
    比喩（5類型）を式が説明する、という構図を保つ。
  </p>
  <p><a href={url('about/')}>このプロジェクトについて →</a></p>
</Base>
