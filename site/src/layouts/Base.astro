---
import '../styles/global.css';
const { title, description = '動物行動学をレンズに、組織を二層で読む理論と発信。' } = Astro.props;
const nav = [
  { href: '/', label: 'ホーム' },
  { href: '/theory/', label: '理論' },
  { href: '/articles/', label: '記事' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href) => href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">動物から組織を読む</a>
      <nav>
        {nav.map((n) => <a href={n.href} class={isActive(n.href) ? 'active' : ''}>{n.label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>動物から組織を読む — 二層理論（ミクロ機構 × マクロ5類型）。</p>
      <p class="muted">
        これは「組織データで係数が当たっているモデル」ではない。価値は<strong>内的整合・非自明な予測・前提の可視化</strong>にある。
      </p>
    </footer>
  </body>
</html>
